const currentContent = content[lang as keyof typeof content] || content.en;
---

<Layout title={currentContent.title} description={currentContent.subtitle}>
  <Nav currentLang={lang} />
  <main class="container">
    <div class="content-wrapper">
      <header class="blog-header">
        <a href={`/${lang}/`} class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          {currentContent.back}
        </a>
        <div class="post-meta">
          <span class="post-date">{currentContent.date}</span>
          <span class="post-separator">•</span>
          <span class="post-author">Jill</span>
        </div>
        <h1 class="post-title">{currentContent.title}</h1>
        <p class="post-subtitle">{currentContent.subtitle}</p>
      </header>

      <article class="post-card">
        <div class="intro-box">
          <p class="intro-lead" set:html={currentContent.intro} />
          <p class="intro-description">{currentContent.introDesc}</p>
        </div>

        {currentContent.bannerUrl && (
          <div class="banner-box">
            <span class="banner-label">{currentContent.bannerLabel}</span>
            <a href={currentContent.bannerUrl} target="_blank" rel="noopener noreferrer" class="banner-link">
              {currentContent.bannerUrl}
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="external-icon">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>
        )}

        <div class="article-body">
          {currentContent.sections.map((sec) => (
            <section class="content-section">
              <h2 class="section-heading">{sec.heading}</h2>
              {sec.paragraphs.map((p) => (
                <p class="section-paragraph" set:html={p} />
              ))}
              {sec.code && (
                <div class="code-block-wrapper">
                  {sec.codeLabel && <span class="code-label">{sec.codeLabel}</span>}
                  <pre class="ascii-code"><code>{sec.code}</code></pre>
                </div>
              )}
            </section>
          ))}

          <section class="remember-box">
            <h2 class="remember-title">{currentContent.rememberTitle}</h2>
            <ul class="remember-list">
              {currentContent.rememberItems.map((item) => (
                <li class="remember-item">
                  <span class="remember-dot">🌸</span>
                  <div class="remember-text" set:html={item} />
                </li>
              ))}
            </ul>
          </section>

          <div class="conclusion-box">
            <p class="closing-paragraph">{currentContent.closing}</p>
            <p class="closing-callout">Stay curious & keep building! 🌸</p>
            <div class="closing-signature">
              <span>With love & code,</span>
              <div class="signature-name">{currentContent.signature}</div>
            </div>
          </div>
        </div>

        <BlogNavigation currentSlug="blog-nvidia-conspiracy-reality" />

        <div class="comments-wrapper">
          <CommentsSection 
            client:load 
            lang={lang} 
            postSlug="blog-nvidia-conspiracy-reality" 
          />
        </div>
      </article>
    </div>
  </main>
  <Animations />
</Layout>

<style>
  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .content-wrapper {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .blog-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #ff9ec4;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: transform 0.2s ease, color 0.2s ease;
    align-self: flex-start;
  }

  .back-link:hover {
    color: #ffb8d4;
    transform: translateX(-4px);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #94a3b8;
    font-size: 0.9rem;
  }

  .post-title {
