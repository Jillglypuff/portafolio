const page = content[lang] || content.es;
---

<Layout title={`${page.title} — Jill Hernandez`} lang={lang}>
  <Animations client:load />
  <Nav lang={lang} />
  
  <!-- Falling Petals Background Animation -->
  <div class="falling-petals-container" aria-hidden="true">
    <div class="petal p-1">🌸</div>
    <div class="petal p-2">🌸</div>
    <div class="petal p-3">🌸</div>
    <div class="petal p-4">🌸</div>
    <div class="petal p-5">🌸</div>
    <div class="petal p-6">🌸</div>
  </div>

  <main class="blog-view">
    <div class="blog-container container-narrow">
      
      <!-- Back navigation link -->
      <div class="back-nav reveal">
        <a href={`/${lang}/`} class="back-link">
          <span class="arrow">←</span> {page.back}
        </a>
      </div>

      <!-- Main Article Card -->
      <article class="blog-card reveal">

        <!-- Post Header -->
        <header class="post-header">
          <div class="post-meta">
            <span class="post-category">🌷 {lang === 'en' ? 'Developer Diary' : lang === 'pt' ? 'Diário de Desenvolvimento' : 'Diario de Desarrollo'}</span>
            <span class="post-dot">•</span>
            <span class="post-date">{page.date}</span>
          </div>
          <h1 class="post-title">{page.title}</h1>
          <p class="post-subtitle">{page.subtitle}</p>
        </header>

        <!-- Post Content Body -->
        <div class="post-content">

          <!-- Intro -->
          <p class="lead-text">{page.intro}</p>
          <p class="lead-desc">{page.introDesc}</p>
          {page.introExtra.map((para) => (
            <p>{para}</p>
          ))}

          <hr class="post-divider" />

          <!-- My first misconception -->
          <div class="post-section">
            <h2 class="section-heading">{page.firstAssumption.heading}</h2>
            <div class="section-body">
              {page.firstAssumption.paragraphs.map((para, idx) => (
                <p>{para}</p>
              ))}
              
              <!-- Compilation Flow Graphic -->
              <div class="compilation-flow">
                <div class="flow-step">
                  <span class="step-icon">TS</span>
                  <span class="step-label">TypeScript</span>
                </div>
                <div class="flow-connector">→</div>
                <div class="flow-step check-step">
                  <span class="step-icon">⚙</span>
                  <span class="step-label">{lang === 'en' ? 'Type Checking' : lang === 'pt' ? 'Checagem de Tipos' : 'Chequeo de Tipos'}</span>
                </div>
                <div class="flow-connector">→</div>
                <div class="flow-step js-step">
                  <span class="step-icon">JS</span>
                  <span class="step-label">JavaScript</span>
                </div>
                <div class="flow-connector">→</div>
                <div class="flow-step browser-step">
                  <span class="step-icon">🌐</span>
                  <span class="step-label">{lang === 'en' ? 'Browser' : lang === 'pt' ? 'Navegador' : 'Navegador'}</span>
                </div>
              </div>
            </div>
          </div>

          <hr class="post-divider" />

          <!-- Bugs are cheaper -->
          <div class="post-section">
            <h2 class="section-heading">{page.cheaperBugs.heading}</h2>
            {page.cheaperBugs.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
            
            <!-- Type checking function code error visualization -->
            <p class="code-label">{page.cheaperBugs.badCallLabel}</p>
            <pre class="code-block error-code"><code>{`function calculateTotal(price: number, tax: number) {
    return price + tax;
}

// ❌ Type checking error in editor:
calculateTotal("100", 13);
//             ~~~~~
// Error: Argument of type 'string' is not assignable 
// to parameter of type 'number'.`}</code></pre>
          </div>

          <hr class="post-divider" />

          <!-- Types are documentation -->
          <div class="post-section">
            <h2 class="section-heading">{page.typesAreDoc.heading}</h2>
            {page.typesAreDoc.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
          </div>

          <hr class="post-divider" />

          <!-- Interfaces -->
          <div class="post-section">
            <h2 class="section-heading">{page.interfaces.heading}</h2>
            {page.interfaces.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
            <pre class="code-block code-block-success"><code>{`interface User {
    id: number;
    name: string;
    email: string;
}`}</code></pre>
          </div>

          <hr class="post-divider" />

          <!-- Generics -->
          <div class="post-section">
            <h2 class="section-heading">{page.generics.heading}</h2>
            {page.generics.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
            <pre class="code-block"><code>{`function identity<T>(value: T): T {
    return value;
}`}</code></pre>
          </div>

          <hr class="post-divider" />

          <!-- Inference -->
          <div class="post-section">
            <h2 class="section-heading">{page.inference.heading}</h2>
            {page.inference.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
            <pre class="code-block"><code>{`const name = "Jill"; // Infers name: string`}</code></pre>
          </div>

          <hr class="post-divider" />

          <!-- Refactoring -->
          <div class="post-section">
            <h2 class="section-heading">{page.refactoring.heading}</h2>
            {page.refactoring.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
          </div>

          <hr class="post-divider" />

          <!-- Tooling -->
          <div class="post-section">
            <h2 class="section-heading">{page.notJustTypes.heading}</h2>
            {page.notJustTypes.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
            <ul class="remember-list" style="margin: 1.5rem 0;">
              {page.notJustTypes.list.map((item) => (
                <li class="remember-item question-item">
                  <span class="remember-dot">✔</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <hr class="post-divider" />

          <!-- Where it shines -->
          <div class="post-section">
            <h2 class="section-heading">{page.whereItShines.heading}</h2>
            {page.whereItShines.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
          </div>

          <hr class="post-divider" />

          <!-- Technical Takeaway -->
          <div class="post-section">
            <h2 class="section-heading">{page.takeaway.heading}</h2>
            {page.takeaway.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
            <ul class="remember-list" style="margin: 1.5rem 0;">
              {page.takeaway.items.map((item) => (
                <li class="remember-item question-item">
                  <span class="remember-dot">✦</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <p>{page.takeaway.closing}</p>
          </div>

          <hr class="post-divider" />

          <!-- Personal Note -->
          <div class="post-section">
            <h2 class="section-heading">{page.personalNote.heading}</h2>
            <div class="section-body">
              {page.personalNote.paragraphs.map((para) => (
                <p>{para}</p>
              ))}
            </div>
          </div>

          <hr class="post-divider" />

          <!-- Things I Want To Remember -->
          <div class="post-section remember-section">
            <h2 class="section-heading">{page.remember.heading}</h2>
            <ul class="remember-list">
              {page.remember.items.map((item) => (
                <li class="remember-item">
                  <span class="remember-dot">✦</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <hr class="post-divider" />

          <!-- Closing -->
          <div class="closing-block">
            <p class="closing-text">{page.closing}</p>
            <p class="closing-sign">{page.closingSign}</p>
            <p class="signature">{page.signature}</p>
          </div>

        </div>
      </article>

    </div>

    <!-- Decorative ambient flowers -->
    <div class="decorative-flower-1" aria-hidden="true">🌸</div>
    <div class="decorative-flower-2" aria-hidden="true">🌺</div>
  </main>
</Layout>

