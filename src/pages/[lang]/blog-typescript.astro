      heading: "Where TypeScript really shines",
      paragraphs: [
        "Small projects? JavaScript is usually enough.",
        "Large applications? That's where TypeScript starts paying for itself.",
        "With hundreds of files, multiple developers, shared components, and reusable APIs, static typing becomes less about convenience and more about maintainability."
      ]
    },
    takeaway: {
      heading: "Technical takeaway 🌸",
      paragraphs: [
        "Some TypeScript concepts every developer should learn:"
      ],
      items: [
        "Primitive Types",
        "Interfaces",
        "Type Aliases",
        "Enums",
        "Generics",
        "Utility Types",
        "Union Types",
        "Type Inference",
