  }
};

const currentContent = content[lang as keyof typeof content] || content.en;
---

<Layout title={currentContent.title} description={currentContent.subtitle}>
  <Nav currentLang={lang} />
  <main class="container">
    <div class="content-wrapper">
      <header class="blog-header">
        <a href={`/${lang}/`} class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          {currentContent.back}
        </a>
        <div class="post-meta">
          <span class="post-date">{currentContent.date}</span>
          <span class="post-separator">•</span>
          <span class="post-author">Jill</span>
        </div>
        <h1 class="post-title">{currentContent.title}</h1>
        <p class="post-subtitle">{currentContent.subtitle}</p>
      </header>

      <article class="post-card">
        <div class="intro-box">
          <p class="intro-lead" set:html={currentContent.intro} />
          <p class="intro-description">{currentContent.introDesc}</p>
        </div>

        {currentContent.bannerUrl && (
          <div class="banner-box">
            <span class="banner-label">{currentContent.bannerLabel}</span>
            <a href={currentContent.bannerUrl} target="_blank" rel="noopener noreferrer" class="banner-link">
              {currentContent.bannerUrl}
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="external-icon">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>
        )}

        <div class="article-body">
          {currentContent.sections.map((sec) => (
            <section class="content-section">
              <h2 class="section-heading">{sec.heading}</h2>
              {sec.paragraphs.map((p) => (
                <p class="section-paragraph" set:html={p} />
              ))}
              {sec.code && (
                <div class="code-block-wrapper">
                  {sec.codeLabel && <span class="code-label">{sec.codeLabel}</span>}
                  <pre class="ascii-code"><code>{sec.code}</code></pre>
                </div>
              )}
            </section>
          ))}

          <section class="remember-box">
            <h2 class="remember-title">{currentContent.rememberTitle}</h2>
            <ul class="remember-list">
              {currentContent.rememberItems.map((item) => (
                <li class="remember-item">
                  <span class="remember-dot">🌸</span>
                  <div class="remember-text" set:html={item} />
                </li>
              ))}
            </ul>
          </section>

          <div class="conclusion-box">
            <p class="closing-paragraph">{currentContent.closing}</p>
            <p class="closing-callout">Keep shipping smart! 🌸</p>
            <div class="closing-signature">
              <span>With love & code,</span>
              <div class="signature-name">{currentContent.signature}</div>
            </div>
          </div>
        </div>

        <BlogNavigation currentSlug="blog-gemini-neon-antigravity" />

        <div class="comments-wrapper">
          <CommentsSection 
            client:load 
            lang={lang} 
            postSlug="blog-gemini-neon-antigravity" 
          />
        </div>
      </article>
    </div>
  </main>
  <Animations />
</Layout>

<style>
  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .content-wrapper {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .blog-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #ff9ec4;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: transform 0.2s ease, color 0.2s ease;
    align-self: flex-start;
  }

  .back-link:hover {
    color: #ffb8d4;
    transform: translateX(-4px);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #94a3b8;
    font-size: 0.9rem;
  }

  .post-title {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.25;
    color: #f8fafc;
    letter-spacing: -0.02em;
  }

  .post-subtitle {
    font-size: 1.15rem;
    color: #94a3b8;
    line-height: 1.5;
  }

  .post-card {
    background: rgba(30, 41, 59, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1.25rem;
    padding: 2.5rem;
    backdrop-filter: blur(12px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  .intro-box {
    background: rgba(255, 158, 196, 0.05);
    border-left: 4px solid #ff9ec4;
    padding: 1.5rem 1.75rem;
    border-radius: 0.5rem 1rem 1rem 0.5rem;
    margin-bottom: 2rem;
  }

  .intro-lead {
    font-size: 1.2rem;
    line-height: 1.7;
    color: #f1f5f9;
    margin-bottom: 0.75rem;
  }

  .intro-lead :global(strong) {
    color: #ff9ec4;
  }

  .intro-description {
    font-size: 1.05rem;
    line-height: 1.6;
    color: #cbd5e1;
    margin: 0;
  }

  .banner-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 158, 196, 0.2);
    border-radius: 0.75rem;
    padding: 0.85rem 1.25rem;
    margin-bottom: 2.5rem;
    font-size: 0.9rem;
  }

  .banner-label {
    color: #94a3b8;
  }

  .banner-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #ff9ec4;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 500;
    word-break: break-all;
    transition: color 0.2s ease;
  }

  .banner-link:hover {
    color: #ffb8d4;
  }

  .external-icon {
    flex-shrink: 0;
  }

  .article-body {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .content-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .section-heading {
    font-size: 1.45rem;
    font-weight: 700;
    color: #f8fafc;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 0.5rem;
    margin-top: 0.5rem;
  }

  .section-paragraph {
    font-size: 1.05rem;
    line-height: 1.75;
    color: #cbd5e1;
    margin: 0;
  }

  .section-paragraph :global(strong) {
    color: #f8fafc;
    font-weight: 600;
  }

  .section-paragraph :global(code) {
    background: rgba(15, 23, 42, 0.8);
    color: #ff9ec4;
    padding: 0.2rem 0.4rem;
    border-radius: 0.3rem;
    font-size: 0.95em;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    border: 1px solid rgba(255, 158, 196, 0.2);
  }

  .code-block-wrapper {
    background: #090d16;
    border: 1px solid rgba(255, 158, 196, 0.2);
    border-radius: 0.85rem;
    overflow: hidden;
    margin: 1.25rem 0;
  }

  .code-label {
    display: block;
    background: rgba(255, 158, 196, 0.08);
    color: #ff9ec4;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.6rem 1.25rem;
    border-bottom: 1px solid rgba(255, 158, 196, 0.15);
    letter-spacing: 0.03em;
  }

  .ascii-code {
    margin: 0;
    padding: 1.25rem;
    overflow-x: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.85rem;
    line-height: 1.5;
    color: #38bdf8;
  }

  .remember-box {
    background: linear-gradient(135deg, rgba(255, 158, 196, 0.1) 0%, rgba(147, 51, 234, 0.08) 100%);
    border: 1px solid rgba(255, 158, 196, 0.25);
    border-radius: 1rem;
    padding: 2rem;
    margin-top: 1rem;
  }

  .remember-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: #ff9ec4;
    margin-bottom: 1.25rem;
  }

  .remember-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .remember-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .remember-dot {
    font-size: 1.1rem;
    line-height: 1.5;
  }

  .remember-text {
    font-size: 1rem;
    line-height: 1.6;
    color: #cbd5e1;
  }

  .remember-text :global(strong) {
    color: #fff;
    font-weight: 600;
  }

  .conclusion-box {
    background: rgba(15, 23, 42, 0.6);
    border-radius: 1rem;
    padding: 1.75rem;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .closing-paragraph {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #cbd5e1;
    margin-bottom: 1.25rem;
  }

  .closing-callout {
    font-size: 1.1rem;
    font-weight: 600;
    color: #ff9ec4;
    margin-bottom: 1.5rem;
  }

  .closing-signature {
    color: #94a3b8;
    font-size: 0.95rem;
  }

  .signature-name {
    font-weight: 700;
    color: #f8fafc;
    margin-top: 0.25rem;
  }

  .comments-wrapper {
    margin-top: 3rem;
  }

  @media (max-width: 768px) {
    .container {
      padding: 1.5rem 1rem;
    }
    
    .post-card {
      padding: 1.5rem;
    }

    .post-title {
      font-size: 1.75rem;
    }
  }
</style>
