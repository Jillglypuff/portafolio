# Las credenciales del VPS SOLO pueden subir archivos, NUNCA borrar ni sobrescribir:

# Volcado de bases de datos comprimido y enviado directamente a S3:
mysqldump --single-transaction -u backup_user -p"$DB_PASS" --all-databases | \\
  gzip -9 | \\
  aws s3 cp - s3://mi-bucket-de-respaldos-aislado/$(date +%Y-%m-%d)-db.sql.gz \\
  --object-lock-mode COMPLIANCE \\
  --object-lock-retain-until-date $(date -d "+30 days" +%Y-%m-%d)

# ¡Incluso si un atacante root ejecuta 'rm -rf /' o cifra el disco del VPS,
