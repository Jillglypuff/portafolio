        fields: ["Matemática", "Física", "Biologia", "Ciência da Computação", "Engenharia", "Humanidades", "Ciências Sociais"],
        paragraphs: [
          "Especialistas contribuíram com perguntas extremamente desafiadoras que exigem conhecimento e raciocínio de nível especialista.",
          "Isso evita a saturação do benchmark onde todos os modelos pontuam 98-99%.",
          "Avalia o quão bem a IA de ponta lida com raciocínio de nível especialista extremamente difícil."
        ]
      },
      {
        num: "6",
        title: "6. GPQA Diamond",
        subtitle: "Perguntas onde até humanos muito inteligentes têm dificuldade",
        desc: "GPQA significa Graduate-Level Google-Proof Q&A.",
        fields: ["Biologia", "Física", "Química"],
        details: "O GPQA Diamond é o subconjunto particularmente difícil de 198 perguntas projetadas para exigir conhecimento profundo do domínio e raciocínio que não pode ser resolvido pesquisando no Google.",
        insight: "Especialistas do domínio se saíram substancialmente melhor do que não-especialistas qualificados com acesso à internet. Encontrar informações não é suficiente; você precisa de conhecimento para entendê-las."
      },
      {
        num: "7",
        title: "7. CritPt",
        subtitle: "Bem-vindo à física em nível de pesquisa",
        desc: "O CritPt se concentra no raciocínio em física em nível de pesquisa com 198 problemas complexos.",
        outputs: ["Funções em Python", "Expressões matemáticas simbólicas", "Respostas numéricas"],
        flow: ["Pergunta", "Raciocínio matemático", "Equação", "Cálculo", "Resultado numérico preciso"],
        paragraphs: ["Avalia se o modelo consegue navegar pelo processo de raciocínio físico até resultados matemáticos precisos."]
      },
      {
        num: "8",
        title: "8. AA-Omniscience",
        subtitle: "A IA sabe o que sabe?",
        desc: "O AA-Omniscience avalia tanto o conhecimento quanto o comportamento de alucinação.",
        quote: "\"Quem ganhou o Prêmio Nobel de Computação em 2025?\" (Não existe esse Prêmio Nobel!).",
        metrics: ["Precisão", "Taxa de Não-Alucinação"],
        comparison: "Modelo A (70/90 corretas, inventa respostas quando não sabe) vs Modelo B (70/75 corretas, expressa incerteza quando não sabe). O Modelo B é muito mais confiável.",
        outro: "🌷 O modelo sabe quando não sabe?"
      },
      {
        num: "9",
        title: "9. AA-LCR",
        subtitle: "A IA consegue realmente entender um contexto enorme?",
        desc: "LCR significa Long Context Reasoning (Raciocínio em Contexto Longo) em documentos de 10K a 100K tokens.",
        flow: ["Buscar", "Conectar", "Raciocinar", "Sintetizar", "Responder"],
        paragraphs: ["Receber 100.000 tokens não é o mesmo que raciocinar corretamente sobre eles. Janela de contexto grande ≠ raciocínio perfeito em contexto longo."]
      }
    ],
    tableSection: {
      heading: "🌸 Agora Olhe para a Prova Inteira",
      intro: "É aqui que tudo começa a fazer sentido. Esses benchmarks não foram escolhidos ao acaso; eles medem dimensões diferentes.",
      tableHeaders: ["Benchmark", "Basicamente pergunta..."],
      rows: [
        { name: "GDPval-AA v2", ask: "Você consegue fazer trabalho profissional?" },
        { name: "τ³-Banking", ask: "Você consegue seguir políticas e usar ferramentas corretamente?" },
        { name: "Terminal-Bench v2.1", ask: "Você consegue realmente trabalhar em um terminal?" },
        { name: "SciCode", ask: "Você consegue programar soluções científicas que funcionam?" },
        { name: "Humanity's Last Exam", ask: "Você consegue resolver perguntas de especialistas extremamente difíceis?" },
        { name: "GPQA Diamond", ask: "Você consegue raciocinar em ciência de nível de pós-graduação?" },
        { name: "CritPt", ask: "Você consegue resolver problemas de física em nível de pesquisa?" },
        { name: "AA-Omniscience", ask: "Você sabe as coisas sem inventar respostas?" },
        { name: "AA-LCR", ask: "Você consegue raciocinar através de enormes quantidades de contexto?" }
      ],
      outro: "Uma Pontuação de Inteligência de IA não é um único número de QI. É uma composição de Trabalho Profissional + Uso de Ferramentas + Código + Raciocínio Científico + Conhecimento + Confiabilidade + Contexto Longo. 🌷"
    },
    plotTwist: {
      heading: "🎀 Reviravolta: A Prova Já Mudou",
      intro: "A lista de benchmarks acima pertencia ao Índice de Inteligência v4.1.1 da Artificial Analysis. A IA avança ridiculamente rápido. Em setembro de 2026, os índices já haviam mudado.",
      changes: [
        "O Terminal-Bench 2.1 foi substituído pelo Terminal-Bench 4.0.",
        "O τ³-Banking foi substituído pelo AutomationBench-AA.",
        "O GPQA Diamond foi removido do índice.",
        "Novas avaliações como AA-Briefcase e GDP.pdf foram introduzidas."
      ],
      saturationTitle: "Saturação do Benchmark",
      saturationDesc: "Conforme os modelos melhoram e pontuam 98-99%, os benchmarks perdem a capacidade de distinguir os melhores. Os pesquisadores criam tarefas mais difíceis, testes privados e novos ambientes realistas. A prova precisa evoluir porque os alunos continuam ficando melhores. 🌸"
    },
    whichMatters: {
      heading: "💗 Então, Qual Benchmark é o Mais Importante?",
      intro: "Não existe um só! E essa é provavelmente a maior lição aqui.",
      scenarios: [
        { need: "Desenvolvimento de Software", focus: "Terminal-Bench + avaliações de código" },
        { need: "Análise de Documentos", focus: "Long-Context Reasoning (LCR)" },
        { need: "Automação de Suporte", focus: "Uso de ferramentas + Seguimento de instruções + Não-alucinação" },
        { need: "Pesquisa Científica", focus: "SciCode + benchmarks de raciocínio científico" }
      ],
      betterQuestion: "A pergunta não deveria ser simplesmente: \"Qual IA tem a pontuação mais alta?\" Uma pergunta muito melhor é: \"Qual avaliação mede a capacidade que eu realmente preciso?\""
    },
    finalThoughts: {
      heading: "🌷 Considerações Finais",
      paragraphs: [
        "Antes de conhecer os benchmarks, os rankings parecem: 53, 51, 47, 42. E pensamos que 53 é mais inteligente.",
        "Agora podemos olhar por baixo desse número. Um modelo é excepcional em código, outro em fluxos agênticos, outro alucina menos, outro lida melhor com documentos longos.",
        "Da próxima vez que vir Modelo de IA — Índice de Inteligência: 53, não pare no número. Clique nos benchmarks. Olhe para as tarefas. Veja como são avaliadas.",
        "Porque às vezes a parte mais interessante não é quem passou na prova. É entender o que estava na prova em primeiro lugar. 🌸"
      ]
    },
    closing: "Da próxima vez que vir uma pontuação, lembre-se: olhe para a prova, não apenas para a nota.",
    closingSign: "Nos vemos na próxima entrada ✨",
    signature: "— Jill"
  }
};

const page = content[lang] || content.en;
---

<Layout title={`${page.title} — Jill Hernandez`} lang={lang}>
  <Animations client:load />
  <Nav lang={lang} />
  
  <!-- Falling Petals Background Animation -->
  <div class="falling-petals-container" aria-hidden="true">
    <div class="petal p-1">🌸</div>
    <div class="petal p-2">🌸</div>
    <div class="petal p-3">🌸</div>
    <div class="petal p-4">🌸</div>
    <div class="petal p-5">🌸</div>
    <div class="petal p-6">🌸</div>
  </div>

  <main class="blog-view">
    <div class="blog-container container-narrow">
      
      <!-- Back navigation link -->
      <div class="back-nav reveal">
        <a href={`/${lang}/`} class="back-link">
          <span class="arrow">←</span> {page.back}
        </a>
      </div>

      <!-- Main Article Card -->
      <article class="blog-card reveal">

        <!-- Post Header -->
        <header class="post-header">
          <div class="header-text-side">
            <div class="post-meta">
              <span class="post-category">🌷 {lang === 'en' ? 'AI Benchmarks' : lang === 'pt' ? 'Benchmarks de IA' : 'Benchmarks de IA'}</span>
              <span class="post-dot">•</span>
              <span class="post-date">{page.date}</span>
            </div>
            <h1 class="post-title">{page.title}</h1>
            <p class="post-subtitle">{page.subtitle}</p>
            
            <div class="tags-row">
              {page.tags.map((tag) => (
                <span class="post-tag">#{tag}</span>
              ))}
            </div>
          </div>
        </header>

        <!-- Post Content Body -->
        <div class="post-content">
          <p class="lead-desc">{page.intro}</p>
          <p class="lead-sub">{page.introDesc}</p>

          <div class="intro-extra-box">
            {page.introExtra.map((line) => (
              <p>{line}</p>
            ))}
          </div>

          <hr class="post-divider" />

          <!-- Section: What is a Benchmark? -->
          <div class="post-section">
            <h2 class="section-heading">{page.whatIsBenchmark.heading}</h2>
            <div class="section-body">
              {page.whatIsBenchmark.paragraphs.map((p) => (
                <p>{p}</p>
              ))}

              <ul class="benchmark-questions-list">
                {page.whatIsBenchmark.questions.map((q) => (
                  <li class="bq-item">
                    <span class="bq-icon">❓</span>
                    <span>{q}</span>
                  </li>
                ))}
              </ul>

              <p>{page.whatIsBenchmark.outro}</p>
            </div>
          </div>

          <hr class="post-divider" />

          <!-- Benchmarks List -->
          <div class="post-section">
            <h2 class="section-heading">📑 The 9 Benchmarks Examined</h2>
            <div class="benchmarks-stack">
              {page.benchmarks.map((bm) => (
                <div class="bm-card">
                  <div class="bm-header">
                    <h3 class="bm-title">{bm.title}</h3>
                    <p class="bm-subtitle">{bm.subtitle}</p>
                  </div>
                  <p class="bm-desc">{bm.desc}</p>

                  {bm.quote && (
                    <div class="bm-quote">
                      <span>💬</span>
                      <p>{bm.quote}</p>
                    </div>
                  )}

                  {bm.deliverables && (
                    <div class="bm-deliverables-box">
                      <p><strong>{bm.deliverablesIntro}</strong></p>
                      <div class="tags-row">
                        {bm.deliverables.map((d) => (
                          <span class="pt-tag">{d}</span>
                        ))}
                      </div>
                    </div>
                  )}

                  {bm.agenticFlow && (
                    <div class="cap-flow-row">
                      {bm.agenticFlow.map((step, idx) => (
                        <>
                          <span class="flow-step">{step}</span>
                          {idx < bm.agenticFlow.length - 1 && <span class="flow-sep">→</span>}
                        </>
                      ))}
                    </div>
                  )}

                  {bm.workflow && (
                    <div class="cap-flow-row">
                      {bm.workflow.map((step, idx) => (
                        <>
                          <span class="flow-step">{step}</span>
                          {idx < bm.workflow.length - 1 && <span class="flow-sep">→</span>}
                        </>
                      ))}
                    </div>
                  )}

                  {bm.flow && (
                    <div class="cap-flow-row">
                      {bm.flow.map((step, idx) => (
                        <>
                          <span class="flow-step">{step}</span>
                          {idx < bm.flow.length - 1 && <span class="flow-sep">→</span>}
                        </>
                      ))}
                    </div>
                  )}

                  {bm.codeSnippet && (
                    <div class="code-compare-box">
                      <pre class="code-block"><code>{bm.codeSnippet}</code></pre>
                    </div>
                  )}

                  {bm.paragraphs && bm.paragraphs.map((p) => (
                    <p>{p}</p>
                  ))}

                  {bm.gradingHeading && (
                    <div class="grading-box">
                      <h4>{bm.gradingHeading}</h4>
                      <p>{bm.grading}</p>
                    </div>
                  )}

                  {bm.backendNotice && <p class="notice-text">{bm.backendNotice}</p>}
                  {bm.testingNotice && <p class="notice-text">{bm.testingNotice}</p>}
                  {bm.formula && <p class="formula-box">{bm.formula}</p>}
                  {bm.fields && (
                    <div class="fields-tags">
                      {bm.fields.map((f) => (
                        <span class="pt-tag">🎓 {f}</span>
                      ))}
                    </div>
                  )}
                  {bm.details && <p>{bm.details}</p>}
                  {bm.insight && <p class="insight-box">{bm.insight}</p>}
                  {bm.comparison && <p class="comp-notice">{bm.comparison}</p>}
                  {bm.outro && <p class="bm-outro">{bm.outro}</p>}
                </div>
              ))}
            </div>
          </div>

          <hr class="post-divider" />

          <!-- Whole Exam Summary Table -->
          <div class="post-section">
            <h2 class="section-heading">{page.tableSection.heading}</h2>
            <div class="section-body">
              <p>{page.tableSection.intro}</p>

              <div class="table-container">
                <table class="bm-table">
                  <thead>
                    <tr>
                      {page.tableSection.tableHeaders.map((th) => (
                        <th>{th}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {page.tableSection.rows.map((row) => (
                      <tr>
                        <td class="bm-name-cell">{row.name}</td>
                        <td class="bm-ask-cell">{row.ask}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <p class="table-outro">{page.tableSection.outro}</p>
            </div>
          </div>

          <hr class="post-divider" />

          <!-- Plot Twist: Exam Changed -->
          <div class="post-section">
            <h2 class="section-heading">{page.plotTwist.heading}</h2>
            <div class="section-body">
              <p>{page.plotTwist.intro}</p>

              <div class="changes-list">
                {page.plotTwist.changes.map((ch) => (
                  <div class="change-item">🔄 {ch}</div>
                ))}
              </div>

              <div class="saturation-box">
                <h4 class="sat-title">⚡ {page.plotTwist.saturationTitle}</h4>
                <p>{page.plotTwist.saturationDesc}</p>
              </div>
            </div>
          </div>

          <hr class="post-divider" />

          <!-- Which Benchmark Matters Most? -->
          <div class="post-section">
            <h2 class="section-heading">{page.whichMatters.heading}</h2>
            <div class="section-body">
              <p>{page.whichMatters.intro}</p>

              <div class="scenarios-grid">
                {page.whichMatters.scenarios.map((sc) => (
                  <div class="scenario-card">
                    <h4 class="sc-need">🎯 {sc.need}</h4>
                    <p class="sc-focus">{sc.focus}</p>
                  </div>
                ))}
              </div>

              <blockquote class="quote-card">
                <p>{page.whichMatters.betterQuestion}</p>
              </blockquote>
            </div>
          </div>

          <hr class="post-divider" />

          <!-- Final Thoughts -->
          <div class="post-section">
            <h2 class="section-heading">{page.finalThoughts.heading}</h2>
            <div class="section-body">
              {page.finalThoughts.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </div>

          <hr class="post-divider" />

          <!-- Closing Block -->
          <div class="closing-block">
            <p class="closing-text">{page.closing}</p>
            <p class="closing-sign">{page.closingSign}</p>
            <p class="signature">{page.signature}</p>
          </div>

          <!-- Comments Section -->
          <CommentsSection slug="blog-exams" lang={lang} client:load />
        </div>
      </article>

    </div>

    <!-- Decorative ambient flowers -->
    <div class="decorative-flower-1" aria-hidden="true">🌸</div>
    <div class="decorative-flower-2" aria-hidden="true">🌺</div>
  </main>
</Layout>

<style>
  /* Falling Petals Animation */
  .falling-petals-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
    overflow: hidden;
  }

  .petal {
    position: absolute;
    top: -10%;
    font-size: 1.5rem;
    opacity: 0.6;
    filter: blur(0.5px);
    animation: fall 14s linear infinite;
    user-select: none;
  }

  .petal.p-1 { left: 10%; animation-delay: 0s; animation-duration: 16s; }
  .petal.p-2 { left: 28%; animation-delay: 3s; animation-duration: 13s; font-size: 1.2rem; }
