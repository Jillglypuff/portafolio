        ]
      },
      {
        num: "4",
        title: "4. SciCode",
        subtitle: "A IA consegue escrever código para problemas científicos?",
        desc: "O SciCode pergunta: Você consegue usar programação para resolver problemas científicos reais?",
        subproblems: "Contém 288 subtarefas derivadas de problemas de pesquisa em 16 disciplinas científicas.",
        flow: ["Contexto Científico", "Implementação em Python", "Execução de Código", "Testes Unitários"],
