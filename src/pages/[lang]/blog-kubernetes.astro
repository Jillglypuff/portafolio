  .remember-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .remember-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .remember-dot {
    font-size: 1.1rem;
    line-height: 1.5;
  }

  .remember-text {
