                  lang === 'pt' ?
                  ["Requisitos", "Design", "Desenvolvimento", "Testes", "Implantação", "Manutenção"] :
                  ["Requisitos", "Diseño", "Desarrollo", "Pruebas", "Despliegue", "Mantenimiento"];
                
                return sdlcSteps.map((step, idx) => (
