const page = content[lang] || content.es;
---

<Layout title={`${page.title} — Jill Hernandez`} lang={lang}>
  <Animations client:load />
  <Nav lang={lang} />
  
  <!-- Falling Petals Background Animation -->
  <div class="falling-petals-container" aria-hidden="true">
    <div class="petal p-1">🌸</div>
    <div class="petal p-2">🌸</div>
    <div class="petal p-3">🌸</div>
    <div class="petal p-4">🌸</div>
    <div class="petal p-5">🌸</div>
    <div class="petal p-6">🌸</div>
  </div>

  <main class="blog-view">
    <div class="blog-container container-narrow">
      
      <!-- Back navigation link -->
      <div class="back-nav reveal">
        <a href={`/${lang}/`} class="back-link">
          <span class="arrow">←</span> {page.back}
        </a>
      </div>

      <!-- Main Article Card -->
      <article class="blog-card reveal">

        <!-- Post Header -->
        <header class="post-header">
          <div class="post-meta">
            <span class="post-category">🌷 {lang === 'en' ? 'Developer Diary' : lang === 'pt' ? 'Diário de Desenvolvimento' : 'Diario de Desarrollo'}</span>
            <span class="post-dot">•</span>
            <span class="post-date">{page.date}</span>
          </div>
          <h1 class="post-title">{page.title}</h1>
          <p class="post-subtitle">{page.subtitle}</p>
        </header>

        <!-- Post Content Body -->
        <div class="post-content">

          <!-- Intro -->
          <p class="lead-text">{page.intro}</p>
          <p class="lead-desc">{page.introDesc}</p>
          {page.introExtra.map((para) => (
            <p>{para}</p>
          ))}

          <hr class="post-divider" />

          <!-- My first misconception -->
          <div class="post-section">
            <h2 class="section-heading">{page.firstAssumption.heading}</h2>
            <div class="section-body">
              {page.firstAssumption.paragraphs.map((para) => {
                if (para.includes("🌸")) {
                  return (
                    <ul class="remember-list" style="margin: 1.5rem 0;">
                      {para.split("\n").map((item) => (
                        <li class="remember-item question-item">
                          <span class="remember-dot">🌸</span>
                          <span>{item.replace("🌸 ", "")}</span>
                        </li>
                      ))}
                    </ul>
                  );
                }
                return <p>{para}</p>;
              })}
            </div>
          </div>

          <hr class="post-divider" />

          <!-- Software begins with questions -->
          <div class="post-section">
            <h2 class="section-heading">{page.questionsSection.heading}</h2>
            <div class="section-body">
              {page.questionsSection.paragraphs.map((para) => (
                <p>{para}</p>
              ))}
              <ul class="remember-list" style="margin: 1.5rem 0;">
                {page.questionsSection.list.map((item) => (
                  <li class="remember-item question-item">
                    <span class="remember-dot">?</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <p>{page.questionsSection.closing}</p>
            </div>
          </div>

          <hr class="post-divider" />

          <!-- Invisible Architecture -->
          <div class="post-section">
            <h2 class="section-heading">{page.invisibleArchitecture.heading}</h2>
            {page.invisibleArchitecture.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
            
            <!-- Interactive pipeline / vertical timeline flowchart -->
            <div class="pipeline-container">
              {(() => {
                const steps = lang === 'en' ? 
                  ["Idea", "Research", "Requirements", "User Flows", "Wireframes", "Architecture", "Database Design", "API Design", "Development", "Testing", "Deployment", "Maintenance"] :
                  lang === 'pt' ?
                  ["Ideia", "Pesquisa", "Requisitos", "Fluxos de Usuário", "Wireframes", "Arquitetura", "Design de Banco de Dados", "Design de API", "Desenvolvimento", "Testes", "Implantação", "Manutenção"] :
                  ["Idea", "Investigación", "Requisitos", "Flujos de Usuario", "Wireframes", "Arquitectura", "Diseño de Base de Datos", "Diseño de API", "Desarrollo", "Pruebas", "Despliegue", "Mantenimiento"];
                
                return steps.map((step, idx) => (
                  <div class="pipeline-item">
                    {idx !== 0 ? <div class="pipeline-line"></div> : null}
                    <div class={`pipeline-node ${step === (lang === 'en' ? 'Development' : lang === 'pt' ? 'Desenvolvimento' : 'Desarrollo') ? 'pipeline-node-active' : ''}`}>
                      <span class="pipeline-index">{String(idx + 1).padStart(2, '0')}</span>
                      <span class="pipeline-label">{step}</span>
                    </div>
                  </div>
                ));
              })()}
            </div>
            
            <p style="margin-top: 2rem;">{page.invisibleArchitecture.closing}</p>
          </div>

          <hr class="post-divider" />

          <!-- Designing before developing -->
          <div class="post-section">
            <h2 class="section-heading">{page.designing.heading}</h2>
            <div class="section-body">
              {page.designing.paragraphs.map((para) => (
                <p>{para}</p>
              ))}
            </div>
          </div>

          <hr class="post-divider" />

          <!-- Databases -->
          <div class="post-section">
            <h2 class="section-heading">{page.databases.heading}</h2>
            {page.databases.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
            
            <p class="code-label">{page.databases.schemaLabel}</p>
            
            <!-- Side-by-side Database Schema Cards -->
            <div class="schema-grid">
              <div class="schema-card">
