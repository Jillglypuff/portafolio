---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import { useTranslations } from '../../i18n/utils';
import Animations from '../../components/Animations.vue';
import CommentsSection from '../../components/CommentsSection.vue';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
    { params: { lang: 'pt' } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang);

const content = {
  en: {
    title: "Dear Diary, I Finally Understood SaaS, PaaS, and IaaS 🌸",
    date: "July 20, 2026",
    subtitle: "A developer diary by Jill",
    back: 'Back to Home',
    intro: "I thought cloud computing was just \"someone else's computer.\"",
    introDesc: "Turns out, it's really about deciding what you want to manage—and what you don't.",
    introExtra: [
      "Cloud computing used to sound like one of those topics everyone casually understood except me.",
      "People would say things like:",
      "\"We'll deploy it to the cloud.\"",
      "Or: \"We'll use a PaaS.\"",
      "Everyone nodded.",
      "I nodded too.",
      "Did I fully understand the difference?",
      "Absolutely not."
    ],
    firstAssumption: {
      heading: "My first misconception",
      paragraphs: [
        "In my head, cloud services looked something like this:",
        "Write code → Deploy → Internet magic ✨ → Application is online",
        "It felt simple.",
        "Until I started deploying my own projects and realized that someone, somewhere, is responsible for much more than just running the application.",
        "Servers. Operating systems. Networking. Security. Scaling. Monitoring. Backups.",
        "And suddenly those three acronyms started making a lot more sense."
      ]
    },
    discovery: {
      heading: "Three layers, three different responsibilities",
      paragraphs: [
        "One of the easiest ways to understand cloud services is by asking:",
        "Who is responsible for what?",
        "The more responsibility the provider takes, the less infrastructure you need to manage."
      ]
