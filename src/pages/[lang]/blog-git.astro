const page = content[lang] || content.es;
---

<Layout title={`${page.title} — Jill Hernandez`} lang={lang}>
  <Animations client:load />
  <Nav lang={lang} />
  
  <!-- Falling Petals Background Animation -->
  <div class="falling-petals-container" aria-hidden="true">
    <div class="petal p-1">🌸</div>
    <div class="petal p-2">🌸</div>
    <div class="petal p-3">🌸</div>
    <div class="petal p-4">🌸</div>
    <div class="petal p-5">🌸</div>
    <div class="petal p-6">🌸</div>
  </div>

  <main class="blog-view">
    <div class="blog-container container-narrow">
      
      <!-- Back navigation link -->
      <div class="back-nav reveal">
        <a href={`/${lang}/`} class="back-link">
          <span class="arrow">←</span> {page.back}
        </a>
      </div>

      <!-- Main Article Card -->
      <article class="blog-card reveal">

        <!-- Post Header -->
        <header class="post-header">
          <div class="post-meta">
            <span class="post-category">🌷 {lang === 'en' ? 'Developer Diary' : lang === 'pt' ? 'Diário de Desenvolvimento' : 'Diario de Desarrollo'}</span>
            <span class="post-dot">•</span>
            <span class="post-date">{page.date}</span>
          </div>
          <h1 class="post-title">{page.title}</h1>
          <p class="post-subtitle">{page.subtitle}</p>
        </header>

        <!-- Post Content Body -->
        <div class="post-content">

          <!-- Intro -->
          <p class="lead-text">{page.intro}</p>
          <p class="lead-desc">{page.introDesc}</p>
          {page.introExtra.map((para) => (
            <p>{para}</p>
          ))}

          <hr class="post-divider" />

          <!-- My first misconception -->
          <div class="post-section">
            <h2 class="section-heading">{page.firstAssumption.heading}</h2>
            <div class="section-body">
              {page.firstAssumption.paragraphs.map((para) => (
                <p>{para}</p>
              ))}
            </div>
          </div>

          <hr class="post-divider" />

          <!-- Git isn't GitHub -->
          <div class="post-section">
            <h2 class="section-heading">{page.gitNotGithub.heading}</h2>
            <div class="section-body">
              {page.gitNotGithub.paragraphs.map((para) => (
                <p>{para}</p>
              ))}
            </div>
          </div>

          <hr class="post-divider" />

          <!-- Every commit tells a story -->
          <div class="post-section">
            <h2 class="section-heading">{page.everyCommit.heading}</h2>
            {page.everyCommit.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
            
            <div class="commit-comparator">
              <div class="commit-side bad-side">
                <div class="commit-header bad-header">{page.everyCommit.badLabel}</div>
                <pre class="code-block error-code"><code>git commit -m "update"
git commit -m "changes"
git commit -m "fix"</code></pre>
              </div>
              <div class="commit-side good-side">
                <div class="commit-header good-header">{page.everyCommit.goodLabel}</div>
                <pre class="code-block code-block-success"><code>git commit -m "Add payment validation before checkout"
git commit -m "Fix responsive navigation on iPad"</code></pre>
              </div>
            </div>

            <p style="margin-top: 1.5rem;">{page.everyCommit.closing}</p>
          </div>

          <hr class="post-divider" />

          <!-- Branches are parallel universes -->
          <div class="post-section">
            <h2 class="section-heading">{page.branches.heading}</h2>
            {page.branches.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
            
            <!-- Branching visualizer -->
            <div class="branch-visualizer">
              <div class="branch-track main-track">
                <span class="track-name">main</span>
                <div class="node node-main"></div>
                <div class="node node-main"></div>
                <div class="node node-main"></div>
              </div>
              <div class="branch-forks">
                <div class="branch-track feat-track">
                  <span class="track-name">feature/payment</span>
                  <div class="connector-fork"></div>
                  <div class="node node-feat"></div>
                  <div class="node node-feat"></div>
                </div>
                <div class="branch-track feat-track">
                  <span class="track-name">feature/profile</span>
                  <div class="connector-fork"></div>
                  <div class="node node-feat"></div>
                </div>
              </div>
            </div>
          </div>

          <hr class="post-divider" />

          <!-- Merge conflicts -->
          <div class="post-section">
            <h2 class="section-heading">{page.conflicts.heading}</h2>
            {page.conflicts.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
            
            <!-- Conflict diff visualizer -->
            <p class="code-label">{lang === 'en' ? 'Conflict representation in file:' : lang === 'pt' ? 'Representação do conflito no arquivo:' : 'Representación del conflicto en el archivo:'}</p>
            <pre class="code-block conflict-code-block"><code>{`<<<<<<< HEAD
const tax = 13;
=======
const tax = 15;
>>>>>>> feature/tax`}</code></pre>
          </div>

          <hr class="post-divider" />

          <!-- Time travel -->
          <div class="post-section">
            <h2 class="section-heading">{page.timeTravel.heading}</h2>
            {page.timeTravel.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
          </div>

          <hr class="post-divider" />

          <!-- Pull Requests -->
          <div class="post-section">
            <h2 class="section-heading">{page.pullRequests.heading}</h2>
            {page.pullRequests.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
          </div>

          <hr class="post-divider" />

          <!-- Teamwork -->
          <div class="post-section">
            <h2 class="section-heading">{page.teamwork.heading}</h2>
            {page.teamwork.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
          </div>

          <hr class="post-divider" />

          <!-- Cheatsheet -->
          <div class="post-section">
            <h2 class="section-heading">{page.cheatsheet.heading}</h2>
            {page.cheatsheet.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
            
            <!-- Git command cheatsheet cards -->
            <div class="git-cheatsheet-grid">
              {(() => {
                const commands = [
                  { cmd: "git status", desc: lang === 'en' ? "Show working tree status" : lang === 'pt' ? "Mostra o status do diretório de trabalho" : "Muestra el estado del árbol de trabajo" },
                  { cmd: "git pull", desc: lang === 'en' ? "Fetch from and integrate with another repository" : lang === 'pt' ? "Busca e integra com outro repositório" : "Busca e integra con otro repositorio" },
                  { cmd: "git add", desc: lang === 'en' ? "Add file contents to the index" : lang === 'pt' ? "Adiciona conteúdo do arquivo ao índice" : "Agrega el contenido del archivo al índice" },
                  { cmd: "git commit", desc: lang === 'en' ? "Record changes to the repository" : lang === 'pt' ? "Grava as alterações no repositório" : "Graba los cambios en el repositorio" },
                  { cmd: "git push", desc: lang === 'en' ? "Update remote refs along with associated objects" : lang === 'pt' ? "Atualiza chaves remotas e objetos associados" : "Actualiza las referencias remotas y objetos asociados" },
                  { cmd: "git checkout", desc: lang === 'en' ? "Switch branches or restore working tree files" : lang === 'pt' ? "Alterna ramos ou restaura arquivos" : "Cambia de rama o restaura archivos" },
                  { cmd: "git switch", desc: lang === 'en' ? "Switch branches easily" : lang === 'pt' ? "Alterna ramos facilmente" : "Cambia de rama fácilmente" },
                  { cmd: "git branch", desc: lang === 'en' ? "List, create, or delete branches" : lang === 'pt' ? "Lista, cria ou deleta ramos" : "Lista, crea o elimina ramas" },
                  { cmd: "git merge", desc: lang === 'en' ? "Join two or more development histories" : lang === 'pt' ? "Junta dois ou mais históricos" : "Une dos o más historiales de desarrollo" },
                  { cmd: "git log", desc: lang === 'en' ? "Show commit logs" : lang === 'pt' ? "Mostra os logs de confirmação" : "Muestra los registros de commits" },
                  { cmd: "git diff", desc: lang === 'en' ? "Show changes between commits, commit and working tree" : lang === 'pt' ? "Mostra alterações entre confirmações e diretório" : "Muestra cambios entre commits y árbol de trabajo" }
                ];
                return commands.map((c) => (
                  <div class="git-cmd-card">
                    <span class="git-cmd-name">{c.cmd}</span>
                    <span class="git-cmd-desc">{c.desc}</span>
                  </div>
                ));
              })()}
            </div>
          </div>

          <hr class="post-divider" />

          <!-- Technical Takeaway -->
          <div class="post-section">
            <h2 class="section-heading">{page.takeaway.heading}</h2>
            {page.takeaway.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
            <ul class="remember-list" style="margin: 1.5rem 0;">
              {page.takeaway.items.map((item) => (
                <li class="remember-item question-item">
                  <span class="remember-dot">✔</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <p>{page.takeaway.closing}</p>
          </div>

          <hr class="post-divider" />

          <!-- Personal Note -->
          <div class="post-section">
            <h2 class="section-heading">{page.personalNote.heading}</h2>
            <div class="section-body">
              {page.personalNote.paragraphs.map((para) => (
                <p>{para}</p>
              ))}
            </div>
          </div>

          <hr class="post-divider" />

          <!-- Things I Want To Remember -->
          <div class="post-section remember-section">
            <h2 class="section-heading">{page.remember.heading}</h2>
            <ul class="remember-list">
              {page.remember.items.map((item) => (
                <li class="remember-item">
                  <span class="remember-dot">✦</span>
