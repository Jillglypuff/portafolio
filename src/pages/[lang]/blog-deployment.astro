    back: "Voltar ao Início",
    intro: "Por muito tempo, pensei que o desenvolvimento de software terminava aqui:",
    introDesc: "Escreva o código. Teste. Pronto.",
    introExtra: [
      "Então implantei minha primeira aplicação real.",
      "Foi aí que descobri uma verdade desconfortável.",
      "A implantação não é o fim do desenvolvimento.",
      "É o momento em que seu código se encontra com o mundo real."
    ],
    firstAssumption: {
      heading: "Minha primeira suposição errada",
