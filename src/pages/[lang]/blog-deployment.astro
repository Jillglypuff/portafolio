const page = content[lang] || content.es;
---

<Layout title={`${page.title} — Jill Hernandez`} lang={lang}>
  <Animations client:load />
  <Nav lang={lang} />
  
  <!-- Falling Petals Background Animation -->
  <div class="falling-petals-container" aria-hidden="true">
    <div class="petal p-1">🌸</div>
    <div class="petal p-2">🌸</div>
    <div class="petal p-3">🌸</div>
    <div class="petal p-4">🌸</div>
    <div class="petal p-5">🌸</div>
    <div class="petal p-6">🌸</div>
  </div>

  <main class="blog-view">
    <div class="blog-container container-narrow">
      
      <!-- Back navigation link -->
      <div class="back-nav reveal">
        <a href={`/${lang}/`} class="back-link">
          <span class="arrow">←</span> {page.back}
        </a>
      </div>

      <!-- Main Article Card -->
      <article class="blog-card reveal">

        <!-- Post Header -->
        <header class="post-header">
          <div class="post-meta">
            <span class="post-category">🌷 {lang === 'en' ? 'Developer Diary' : lang === 'pt' ? 'Diário de Desenvolvimento' : 'Diario de Desarrollo'}</span>
            <span class="post-dot">•</span>
            <span class="post-date">{page.date}</span>
          </div>
          <h1 class="post-title">{page.title}</h1>
          <p class="post-subtitle">{page.subtitle}</p>
        </header>

        <!-- Post Content Body -->
        <div class="post-content">

          <!-- Intro -->
          <p class="lead-text">{page.intro}</p>
          <p class="lead-desc">{page.introDesc}</p>
          {page.introExtra.map((para) => (
            <p>{para}</p>
          ))}

          <hr class="post-divider" />

          <!-- My first misconception -->
          <div class="post-section">
            <h2 class="section-heading">{page.firstAssumption.heading}</h2>
            <div class="section-body">
              <p>{page.firstAssumption.paragraphs[0]}</p>
              
              <!-- Timeline expectations vs reality -->
              <div class="timeline-container">
                <div class="timeline-box expect-box">
                  <div class="timeline-title">{lang === 'en' ? 'Expectation' : lang === 'pt' ? 'Expectativa' : 'Expectativa'}</div>
                  <ul class="timeline-steps">
                    <li><span class="step-num">1</span> git push</li>
                    <li><span class="step-num">2</span> Production</li>
                    <li><span class="step-num">3</span> 🎉 {lang === 'en' ? 'Happy' : lang === 'pt' ? 'Feliz' : 'Feliz'}</li>
                  </ul>
                </div>
                
                <div class="timeline-box reality-box">
                  <div class="timeline-title error-title">{lang === 'en' ? 'Reality' : lang === 'pt' ? 'Realidade' : 'Realidad'}</div>
                  <ul class="timeline-steps">
                    <li><span class="step-num">1</span> git push</li>
                    <li><span class="step-num step-err">2</span> Build Failed</li>
                    <li><span class="step-num">3</span> Fix Env Vars</li>
                    <li><span class="step-num">4</span> Build Again</li>
                    <li><span class="step-num step-err">5</span> Another Error</li>
                    <li><span class="step-num">6</span> Fix Deps</li>
                    <li><span class="step-num">7</span> Deploy</li>
                    <li><span class="step-num step-err">8</span> Production Bug</li>
                    <li><span class="step-num">9</span> Rollback</li>
                    <li><span class="step-num">10</span> Coffee ☕</li>
                  </ul>
                </div>
              </div>

              <p style="margin-top: 1.5rem;">{page.firstAssumption.paragraphs[1]}</p>
              <p>{page.firstAssumption.paragraphs[2]}</p>
            </div>
          </div>

          <hr class="post-divider" />

          <!-- Your app doesn't run on your computer -->
          <div class="post-section">
            <h2 class="section-heading">{page.notYourComputer.heading}</h2>
            {page.notYourComputer.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
            
            <ul class="remember-list" style="margin: 1.5rem 0;">
              {page.notYourComputer.list.map((item) => (
                <li class="remember-item question-item">
                  <span class="remember-dot">📍</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <p>{page.notYourComputer.closing}</p>
          </div>

          <hr class="post-divider" />

          <!-- Environment variables matter -->
          <div class="post-section">
            <h2 class="section-heading">{page.envVars.heading}</h2>
            {page.envVars.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
            
            <!-- Code blocks comparator for Env variables -->
            <div class="env-comparator">
              <div class="env-side bad-side">
                <div class="env-header bad-header">{page.envVars.badLabel}</div>
                <pre class="code-block error-code"><code>{`// ❌ Hardcoded secrets (DANGEROUS)
const apiKey = "AIzaSy********";
const dbHost = "12.34.56.78";`}</code></pre>
              </div>
              <div class="env-side good-side">
                <div class="env-header good-header">{page.envVars.goodLabel}</div>
                <pre class="code-block code-block-success"><code>{`# env variables (SAFE & DYNAMIC)
APP_URL=https://example.com
DB_HOST=localhost
DB_DATABASE=my_database
API_KEY=********`}</code></pre>
              </div>
            </div>

            <p style="margin-top: 1.5rem;">{page.envVars.closing}</p>
          </div>

          <hr class="post-divider" />

          <!-- Deployment is more than uploading files -->
          <div class="post-section">
            <h2 class="section-heading">{page.moreThanUploading.heading}</h2>
            {page.moreThanUploading.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
            
            <!-- Horizontal Deployment Flow Chart -->
            <div class="flow-list">
              {(() => {
                const flowSteps = ["Source Code", "Git", "Build", "Install Dependencies", "Run Tests", "Generate Assets", "Deploy", "Production", "Monitoring"];
                const localizedFlowSteps = lang === 'en' ? flowSteps :
                  lang === 'pt' ? ["Código Fonte", "Git", "Build", "Instalar Dependências", "Executar Testes", "Gerar Assets", "Implantar", "Produção", "Monitoramento"] :
                  ["Código Fuente", "Git", "Build", "Instalar Dependencias", "Ejecutar Pruebas", "Generar Assets", "Desplegar", "Producción", "Monitoreo"];
                
                return localizedFlowSteps.map((step, idx) => (
                  <div class="flow-item">
                    {idx !== 0 ? <div class="flow-arrow">↓</div> : null}
                    <div class="flow-pill">{step}</div>
                  </div>
                ));
              })()}
            </div>
