      ],
      badLabel: "En lugar de escribir claves de API directamente en el código:",
      goodLabel: "Las aplicaciones deberían depender de variables de entorno:",
      closing: "Mantener la configuración fuera del código hace que las aplicaciones sean más seguras y fáciles de mantener."
    },
    moreThanUploading: {
