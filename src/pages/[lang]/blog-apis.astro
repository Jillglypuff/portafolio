const page = content[lang] || content.es;
---

<Layout title={`${page.title} — Jill Hernandez`} lang={lang}>
  <Animations client:load />
  <Nav lang={lang} />
  
  <!-- Falling Petals Background Animation -->
  <div class="falling-petals-container" aria-hidden="true">
    <div class="petal p-1">🌸</div>
    <div class="petal p-2">🌸</div>
    <div class="petal p-3">🌸</div>
    <div class="petal p-4">🌸</div>
    <div class="petal p-5">🌸</div>
    <div class="petal p-6">🌸</div>
  </div>

  <main class="blog-view">
    <div class="blog-container container-narrow">
      
      <!-- Back navigation link -->
      <div class="back-nav reveal">
        <a href={`/${lang}/`} class="back-link">
          <span class="arrow">←</span> {page.back}
        </a>
      </div>

      <!-- Main Article Card -->
      <article class="blog-card reveal">

        <!-- Post Header -->
        <header class="post-header">
          <div class="post-meta">
            <span class="post-category">🌷 {lang === 'en' ? 'Developer Diary' : lang === 'pt' ? 'Diário de Desenvolvimento' : 'Diario de Desarrollo'}</span>
            <span class="post-dot">•</span>
            <span class="post-date">{page.date}</span>
          </div>
          <h1 class="post-title">{page.title}</h1>
          <p class="post-subtitle">{page.subtitle}</p>
        </header>

        <!-- Post Content Body -->
        <div class="post-content">

          <!-- Intro -->
          <p class="lead-text">{page.intro}</p>
          <p class="lead-desc">{page.introDesc}</p>
          {page.introExtra.map((para) => (
            <p>{para}</p>
          ))}

          <hr class="post-divider" />

          <!-- My first misconception -->
          <div class="post-section">
            <h2 class="section-heading">{page.firstAssumption.heading}</h2>
            <div class="section-body">
              {page.firstAssumption.paragraphs.map((para) => (
                <p>{para}</p>
              ))}
              
              <!-- Styled routes list -->
              <div class="api-endpoints-container spec-endpoints">
                <div class="api-endpoint">
                  <span class="method get">GET</span>
                  <span class="path">/users</span>
                </div>
                <div class="api-endpoint">
                  <span class="method post">POST</span>
                  <span class="path">/orders</span>
                </div>
                <div class="api-endpoint">
                  <span class="method delete">DELETE</span>
                  <span class="path">/products/15</span>
                </div>
              </div>

              {page.firstAssumption.paragraphsAfter.map((para) => (
                <p>{para}</p>
              ))}
            </div>
          </div>

          <hr class="post-divider" />

          <!-- APIs are contracts -->
          <div class="post-section">
            <h2 class="section-heading">{page.apisAreContracts.heading}</h2>
            {page.apisAreContracts.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
            
            <!-- Contract Comparator -->
            <div class="contract-comparator">
              <div class="contract-side expect">
                <div class="contract-header">{lang === 'en' ? 'Expected JSON' : lang === 'pt' ? 'JSON Esperado' : 'JSON Esperado'}</div>
                <pre class="code-block"><code>{`{
  "id": 15,
  "name": "Jill"
}`}</code></pre>
              </div>
              <div class="contract-arrow">⚡</div>
              <div class="contract-side actual">
                <div class="contract-header error-header">{lang === 'en' ? 'Changed Backend' : lang === 'pt' ? 'Backend Alterado' : 'Backend Modificado'}</div>
                <pre class="code-block error-code"><code>{`{
  "userId": 15,    // ❌ Error
  "fullName": "Jill Hernandez"
}`}</code></pre>
              </div>
            </div>

            <p style="margin-top: 1.5rem;">{page.apisAreContracts.afterDesc}</p>
          </div>

          <hr class="post-divider" />

          <!-- A good API answers questions -->
          <div class="post-section">
            <h2 class="section-heading">{page.goodAnswers.heading}</h2>
            {page.goodAnswers.paragraphs.map((para) => (
              <p>{para}</p>
            ))}
            
            <div class="response-diff">
              <div class="diff-block-bad">
                <div class="diff-title">{lang === 'en' ? 'Vending Machine (Not helpful)' : lang === 'pt' ? 'Máquina de Vendas' : 'Máquina Expendedora'}</div>
                <pre class="code-block"><code>{`{
  "status": true
}`}</code></pre>
              </div>
              <div class="diff-block-good">
                <div class="diff-title success-title">{lang === 'en' ? 'Conversation (Helpful)' : lang === 'pt' ? 'Conversação' : 'Conversación'}</div>
                <pre class="code-block code-block-success"><code>{`{
  "success": true,
