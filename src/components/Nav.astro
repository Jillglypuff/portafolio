---
import { useTranslations } from '../i18n/utils';
import { Icon } from 'astro-icon/components';

const { lang } = Astro.props;
const t = useTranslations(lang);
---
<nav class="nav" id="nav">
  <a href={`/${lang}/#hero`} class="nav-logo">Jill H.</a>
  
  <div class="nav-menu-group">
    <ul class="nav-links">
      <li><a href={`/${lang}/#about`}>{t('nav.about')}</a></li>
      <li><a href={`/${lang}/#projects`}>{t('nav.projects')}</a></li>
      <li><a href={`/${lang}/#skills`}>{t('nav.tech')}</a></li>

      <li><a href={`/${lang}/#blog`}>{t('nav.blog')}</a></li>
    </ul>

    <div class="nav-actions">
      <!-- Outlined Day/Night Mode Switcher (Costa Rica Time) -->
      <button 
        type="button" 
        class="nav-theme-btn" 
        id="theme-toggle-btn"
        title="Modo Día / Noche (Hora Costa Rica)"
        aria-label="Alternar modo día y noche"
      >
        <!-- Outlined Sun (Shows in dark mode to switch to day) -->
        <svg class="theme-icon sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4.5"></circle>
          <path d="M12 2v2.5M12 19.5V22M4.22 4.22l1.77 1.77M18.01 18.01l1.77 1.77M2 12h2.5M19.5 12H22M4.22 19.78l1.77-1.77M18.01 5.99l1.77-1.77"></path>
        </svg>
        <!-- Outlined Moon (Shows in light mode to switch to night) -->
        <svg class="theme-icon moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <a href={`/${lang}/#contact`} class="nav-cta">{t('nav.contact')}</a>
      
      <!-- Language Dropdown - Far Right Corner -->
      <div class="lang-selector">
        <button class="lang-btn" id="lang-btn" aria-label="Select language">
          <Icon name="lucide:globe" size={18} />
          <Icon name="lucide:chevron-down" size={12} class="chevron" />
        </button>
        
        <div class="lang-dropdown" id="lang-menu">
          <div class="dropdown-inner">
            <a href="/en/" class={lang === 'en' ? 'active' : ''}>
              <span class="flag">🇺🇸</span> English
            </a>
            <a href="/es/" class={lang === 'es' ? 'active' : ''}>
              <span class="flag">🇪🇸</span> Español
            </a>
            <a href="/pt/" class={lang === 'pt' ? 'active' : ''}>
              <span class="flag">🇧🇷</span> Português
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  function getCostaRicaHour() {
    try {
      const crStr = new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/Costa_Rica',
        hour: 'numeric',
        hour12: false
      }).format(new Date());
      return parseInt(crStr, 10);
    } catch (e) {
      const d = new Date();
      return (d.getUTCHours() - 6 + 24) % 24;
    }
  }

  function applyThemeMode(isDay) {
    const root = document.documentElement;
    if (isDay) {
      root.classList.add('theme-day', 'zen-theme-day');
      root.classList.remove('theme-night', 'zen-theme-night');
    } else {
      root.classList.add('theme-night', 'zen-theme-night');
      root.classList.remove('theme-day', 'zen-theme-day');
    }
    window.dispatchEvent(new CustomEvent('jill-theme-changed', { detail: { isDay } }));
  }

  function initTheme() {
    const saved = localStorage.getItem('jill_theme_mode');
    let isDay = false;
    if (saved === 'day') {
      isDay = true;
    } else if (saved === 'night') {
      isDay = false;
    } else {
      const h = getCostaRicaHour();
      isDay = (h >= 6 && h < 18);
    }
    applyThemeMode(isDay);
  }

  function setupThemeToggle() {
    const themeBtn = document.getElementById('theme-toggle-btn');
    if (!themeBtn) return;
    
    // Replace to avoid duplicate event listeners on page reload
    const newBtn = themeBtn.cloneNode(true);
    themeBtn.parentNode.replaceChild(newBtn, themeBtn);
    
    newBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isDayNow = document.documentElement.classList.contains('theme-day');
      const newDay = !isDayNow;
      localStorage.setItem('jill_theme_mode', newDay ? 'day' : 'night');
      applyThemeMode(newDay);
    });
  }

  const btn = document.getElementById('lang-btn');
  const menu = document.getElementById('lang-menu');

  if (btn && menu) {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.classList.toggle('is-open');
      btn.classList.toggle('is-active');
    });

    document.addEventListener('click', () => {
      menu.classList.remove('is-open');
      btn.classList.remove('is-active');
    });
  }

  initTheme();
  setupThemeToggle();

  document.addEventListener('astro:page-load', () => {
    initTheme();
    setupThemeToggle();
  });
</script>

<style>
  /* Use global.css structure, only adding the necessary grouping and dropdown logic */
  
  .nav-menu-group {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px; /* Reduced gap to ensure visibility of all 4 items */
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* CTA Override: Cursive + Gradient */
  .nav-cta {
    font-family: var(--font-cursive) !important;
    font-size: 1.15rem !important;
    background: linear-gradient(135deg, var(--rose), var(--rose-dark)) !important;
    letter-spacing: 0.03em !important;
    padding: 6px 24px !important;
  }

  /* Outlined Theme Toggle Button (No emoji, minimalist vector stroke) */
  .nav-theme-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--rose);
    border-radius: var(--radius-xl);
    cursor: pointer;
    transition: var(--transition);
    padding: 0;
  }

  .nav-theme-btn:hover {
    color: var(--rose);
    border-color: var(--rose);
    background: rgba(255, 75, 145, 0.08);
    transform: scale(1.08);
  }

  .theme-icon {
    width: 18px;
    height: 18px;
    display: none;
    stroke: var(--rose);
  }

  :global(html:not(.theme-day)) .sun-icon {
    display: block;
  }

  :global(html.theme-day) .moon-icon {
    display: block;
  }

  /* Language Selector Styles - Minimalist & Far Right */
  .lang-selector {
    position: relative;
    z-index: 200;
  }

  .lang-btn {
    display: flex;
    align-items: center;
    gap: 4px;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-muted);
    padding: 6px 10px;
    border-radius: var(--radius-xl);
    cursor: pointer;
    transition: var(--transition);
  }

  .lang-btn:hover, .lang-btn.is-active {
    color: var(--rose);
    border-color: var(--rose);
    background: rgba(255, 75, 145, 0.05);
  }

  .lang-btn .chevron {
    transition: transform 0.3s ease;
    opacity: 0.5;
  }
  .lang-btn.is-active .chevron {
    transform: rotate(180deg);
  }

  .lang-dropdown {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    width: 160px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px) scale(0.95);
    transition: var(--transition);
    pointer-events: none;
  }

  .lang-dropdown.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
    pointer-events: all;
  }

  .dropdown-inner {
    background: var(--bg-tint);
    backdrop-filter: blur(20px);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 8px;
    box-shadow: var(--shadow-lg);
  }

  .lang-dropdown a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    color: var(--text-muted);
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
    transition: var(--transition);
    text-decoration: none;
  }

  .lang-dropdown a:hover {
    background: rgba(255, 75, 145, 0.1);
    color: var(--rose);
  }

  .lang-dropdown a.active {
    color: var(--rose);
    font-weight: 600;
    background: rgba(255, 75, 145, 0.05);
  }

  .flag { font-size: 1.1rem; }

  @media (max-width: 1024px) {
    .nav-menu-group { gap: 20px; }
    .nav-actions { gap: 12px; }
  }

  @media (max-width: 820px) {
    .nav-links { gap: 16px; }
  }

  @media (max-width: 768px) {
    .nav-links { display: none; }
  }
</style>
