<script>
  function todayStr() {
    var d = new Date();
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
  }

  function publishDrafts() {
    var section = document.getElementById('blog');
    if (!section) return;
    var track = document.getElementById('entriesCarousel');
    if (!track) return;

    var today = todayStr();
    var upcomingItems = section.querySelectorAll('.upcoming-item');
    var hasNew = false;

    upcomingItems.forEach(function (item) {
      var pubDate = item.getAttribute('data-publish-date');
      if (pubDate && pubDate <= today) {
        var num = item.getAttribute('data-number');
        item.remove();
        hasNew = true;

        var slide = track.querySelector('.carousel-slide[data-number="' + num + '"]');
        if (slide) {
          slide.style.display = '';
          slide.removeAttribute('data-publish-date');
        }
      }
    });

    if (!hasNew) return;

    var slides = Array.from(track.querySelectorAll('.carousel-slide'));
    slides.sort(function (a, b) {
      return parseInt(b.getAttribute('data-number'), 10) - parseInt(a.getAttribute('data-number'), 10);
    });

    slides.forEach(function (slide, idx) {
      slide.setAttribute('data-index', idx);
      track.appendChild(slide);
    });

    setupCarousel();
  }

  function setupCarousel() {
    var track = document.getElementById('entriesCarousel');
    if (!track) return;

    var visibleSlides = track.querySelectorAll('.carousel-slide:not([style*="display:none"])');
    var wrapper = track.parentElement;
    var prevBtn = document.querySelector('.carousel-prev');
    var nextBtn = document.querySelector('.carousel-next');

    if (visibleSlides.length === 0) return;

    var perPage = 2;
    var totalPages = Math.ceil(visibleSlides.length / perPage);
    var currentPage = 0;

    if (totalPages <= 1) {
      if (prevBtn) prevBtn.style.display = 'none';
      if (nextBtn) nextBtn.style.display = 'none';
      return;
    } else {
      if (prevBtn) prevBtn.style.display = '';
      if (nextBtn) nextBtn.style.display = '';
    }

    function goToPage(page) {
      if (page < 0) page = totalPages - 1;
      if (page >= totalPages) page = 0;
      var offset = page * wrapper.offsetHeight;
      track.style.transform = 'translateY(-' + offset + 'px)';
      currentPage = page;
    }

    if (prevBtn) {
      var newPrev = prevBtn.cloneNode(true);
      prevBtn.parentNode.replaceChild(newPrev, prevBtn);
      newPrev.addEventListener('click', function () { goToPage(currentPage - 1); });
    }

    if (nextBtn) {
      var newNext = nextBtn.cloneNode(true);
      nextBtn.parentNode.replaceChild(newNext, nextBtn);
      newNext.addEventListener('click', function () { goToPage(currentPage + 1); });
    }
  }

  document.addEventListener('astro:page-load', function () {
    publishDrafts();
    setupCarousel();
  });
  publishDrafts();
  setupCarousel();
</script>
