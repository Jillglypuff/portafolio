---
import { useTranslations } from '../i18n/utils';
import ProjectsFloral from './ProjectsFloral.vue';
import ProjectsCarousel from './ProjectsCarousel.vue';
import type { ProjectItem } from './ProjectsCarousel.vue';

const { lang } = Astro.props;
const t = useTranslations(lang);

// Dynamically load images for mockups
const capturasGlob: Record<string, any> = import.meta.glob('../assets/proyectos/capturas/*.{png,jpg,jpeg,JPG,PNG}', { eager: true, import: 'default' });
const canvaGlob: Record<string, any> = import.meta.glob('../assets/proyectos/diseños canva/*.{png,jpg,jpeg,JPG,PNG}', { eager: true, import: 'default' });
const figmaGlob: Record<string, any> = import.meta.glob('../assets/proyectos/figma/*.{png,jpg,jpeg,JPG,PNG}', { eager: true, import: 'default' });
const allProyectosGlob: Record<string, any> = import.meta.glob('../assets/proyectos/**/*.{png,jpg,jpeg,JPG,PNG}', { eager: true, import: 'default' });

const getSrcs = (globObj: Record<string, any>, filterFn: (filename: string) => boolean) => {
  return Object.entries(globObj)
    .filter(([path]) => {
      const fileName = path.split('/').pop() || '';
      return filterFn(fileName);
    })
    .sort(([pathA], [pathB]) => pathA.localeCompare(pathB))
    .map(([_, img]) => (typeof img === 'string' ? img : img.src));
};

// Build structured project & mockup objects (Apps section removed, mockups organized for carousel)
const projects: ProjectItem[] = [
  // ─── WEB SYSTEMS & PLATFORMS ───────────────────────────────────
  {
    id: 'tienda-lagatacr',
    title: 'Tienda La Gata CR',
    category: 'web',
    categoryLabel: 'Full-Stack E-Commerce',
    oneLiner: 'Plataforma e-commerce completa con panel de administración e integración de pagos.',
    images: getSrcs(capturasGlob, name => name.toLowerCase().includes('tienda_lagatacr')),
    aspectRatio: 'landscape',
    demoUrl: 'https://lagatacr.com/',
    technologies: ['React', 'Laravel', 'MySQL', 'REST API', 'TailwindCSS'],
    caseStudy: {
      problem: 'Automatizar las ventas, gestión de catálogo e inventario para una tienda de moda en Costa Rica.',
      solution: 'Arquitectura desacoplada con Frontend SPA en React y Backend REST API en Laravel.',
      highlights: ['Panel administrativo completo para productos y pedidos', 'Gestión de anuncios publicitarios dinámicos', 'Checkout integrado seguro']
    }
  },
  {
    id: 'skillmatch',
    title: 'SkillMatch AI',
    category: 'web',
    categoryLabel: 'Plataforma Web + IA',
    oneLiner: 'Plataforma web con Inteligencia Artificial para análisis y filtrado automatizado de CVs.',
    images: getSrcs(capturasGlob, name => name.toLowerCase().includes('skill')),
    aspectRatio: 'landscape',
    demoUrl: 'https://skillmatch.tejidev.com/',
    technologies: ['Python', 'AI / NLP', 'React', 'REST API'],
    caseStudy: {
      problem: 'Agilizar el filtrado manual de currículums en procesos de contratación masivos.',
      solution: 'Motor de Procesamiento de Lenguaje Natural (NLP) en Python para extracción de habilidades y cálculo de compatibilidad.',
      highlights: ['Extracción automatizada de información en documentos CV', 'Puntuación semántica de coincidencia', 'Dashboard interactivo de análisis']
    }
  },
  {
    id: 'pam',
    title: 'PAM — Consulta de Multas',
    category: 'web',
    categoryLabel: 'Full-Stack (React & C++)',
    oneLiner: 'Portal web de alto rendimiento para consulta y verificación rápida de multas de tránsito.',
    images: getSrcs(capturasGlob, name => name.toLowerCase().includes('pam')),
    aspectRatio: 'landscape',
    demoUrl: 'https://pamcr.netlify.app/',
    technologies: ['React', 'C++', 'AWS (Database)', 'REST API'],
    caseStudy: {
      problem: 'Brindar a los conductores un medio confiable, rápido y seguro para consultar el estado de infracciones de tránsito.',
      solution: 'Arquitectura Full-Stack de alto rendimiento con Frontend interactivo en React, Backend desarrollado en C++ y Base de Datos alojada en AWS.',
      highlights: [
        'Frontend interactivo y responsivo en React',
        'Backend de alto rendimiento y baja latencia en C++',
        'Base de datos gestionada y alojada en la nube de AWS',
        'Integración con servicios de consulta en tiempo real'
      ]
    }
  },
  {
    id: 'teji',
    title: 'Teji Studio Landing Page',
    category: 'web',
    categoryLabel: 'Landing Page',
    oneLiner: 'Sitio web corporativo para estudio de desarrollo de software.',
    images: getSrcs(capturasGlob, name => name.toLowerCase().includes('teji')),
    aspectRatio: 'landscape',
    demoUrl: 'https://www.tejidev.com/',
    technologies: ['React', 'CSS3', 'UX/UI Design'],
    caseStudy: {
      problem: 'Reflejar la capacidad técnica y propuesta de valor del estudio ante potenciales clientes.',
      solution: 'Landing page con estética moderna, micro-interacciones suaves y estructura clara de servicios.',
      highlights: ['Diseño moderno responsivo', 'Optimización de velocidad y SEO', 'Secciones modulares de servicios']
    }
  },
  {
    id: 'lp-lgcr-bootstrap',
    title: 'Landing Page La Gata CR — Bootstrap',
    category: 'web',
    categoryLabel: 'Landing Page (HTML & Bootstrap)',
    oneLiner: 'Primera landing page promocional para tienda de moda maquetada en HTML con Bootstrap.',
    images: getSrcs(capturasGlob, name => name.toLowerCase().includes('lp_lgcr1') || name.toLowerCase().includes('lp_lgcr2')),
    aspectRatio: 'landscape',
    technologies: ['HTML5', 'Bootstrap', 'JavaScript', 'CSS3'],
    caseStudy: {
      problem: 'Primera landing page promocional para captación de clientes y conversión durante campañas específicas.',
      solution: 'Maquetación responsiva con HTML5 y el framework Bootstrap, integrando dos pantallas de la misma landing page (vistas 1 y 2).',
      highlights: [
        'Maquetación responsiva con HTML5 y Bootstrap',
        'Vistas 1 y 2 corresponden a la misma landing page',
        'Diseño orientado a conversión y llamados a la acción claros'
      ]
    }
  },
  {
    id: 'lp-lgcr-tailwind',
    title: 'Landing Page La Gata CR — TailwindCSS',
    category: 'web',
    categoryLabel: 'Landing Page (TailwindCSS)',
    oneLiner: 'Segunda versión de landing page para nueva campaña desarrollada con TailwindCSS.',
    images: getSrcs(capturasGlob, name => name.toLowerCase().includes('lp_lgcr3')),
    aspectRatio: 'landscape',
    technologies: ['TailwindCSS', 'HTML5', 'JavaScript'],
    caseStudy: {
      problem: 'Segunda landing page para una nueva campaña de La Gata CR con requerimiento de estética más estilizada y moderna.',
      solution: 'Maquetación utility-first con TailwindCSS (captura 3) para un control visual milimétrico y componentes livianos.',
      highlights: [
        'Segunda landing page independiente de la marca (captura 3)',
        'Desarrollo moderno y estilizado con TailwindCSS',
        'Carga ultrarrápida y optimización para pantallas móviles'
      ]
    }
  },
  {
    id: 'ssform',
    title: 'SS Form UI',
    category: 'web',
    categoryLabel: 'Maquetación UI HTML',
    oneLiner: 'Componente y diseño de formulario web solicitado a medida en HTML y CSS.',
    images: getSrcs(capturasGlob, name => name.toLowerCase().includes('ssform')),
    aspectRatio: 'landscape',
    technologies: ['HTML5', 'CSS3', 'JavaScript'],
    caseStudy: {
      problem: 'Requerimiento específico del cliente para diseñar y maquetar una interfaz de formulario limpia y estructurada puramente en HTML.',
      solution: 'Desarrollo de interfaz de usuario en HTML5 semántico con estilos CSS personalizados para los distintos campos y estados de formulario.',
      highlights: [
        'Componente UI maquetado a medida en HTML y CSS según requerimiento',
        'Estructura semántica, accesible y limpia',
        'Diseño visual para campos de datos y validaciones'
      ]
    }
  },

  // ─── FIGMA UI/UX DESIGN & PROTOTYPES ───────────────────────────
  {
    id: 'figma-ui',
    title: 'Bloom — Figma UI/UX',
    category: 'figma',
    categoryLabel: 'UI/UX Design Figma',
    oneLiner: 'Prototipos interactivos, wireframes de alta fidelidad y sistemas de diseño visual.',
    images: Object.values(figmaGlob).map((img: any) => typeof img === 'string' ? img : img.src),
    aspectRatio: 'landscape',
    technologies: ['Figma', 'Wireframing', 'UI/UX Prototyping', 'Design Systems'],
    caseStudy: {
      problem: 'Diseñar arquitectura de información y prototipos navegables antes del desarrollo.',
      solution: 'Creación de wireframes de alta fidelidad, componentes reusables y prototipos dinámicos para Bloom y aplicaciones web.',
      highlights: ['Wireframing de alta fidelidad', 'Prototipado interactivo en Figma', 'Diseño de sistemas de UI y tokens']
    }
  },

  // ─── SOCIAL MEDIA & BRANDING (CANVA & MOBILE FORMATS) ─────────
  {
    id: 'post-lagatacr',
    title: 'La Gata CR — Instagram Posts',
    category: 'social',
    categoryLabel: 'Social Media (Post 1:1)',
    oneLiner: 'Colección de piezas gráficas promocionales e informativas en formato post de Instagram.',
    images: getSrcs(canvaGlob, name => name.toLowerCase().includes('ig_postlagata')),
    aspectRatio: 'square',
    technologies: ['Figma', 'Canva', 'Content Design', 'IG Format 1:1'],
    caseStudy: {
      problem: 'Mantener la comunidad interactuando activamente mediante contenido de alto impacto visual.',
      solution: 'Plantillas cuadradas para publicaciones adaptadas a campañas del e-commerce.',
      highlights: ['Plantillas cuadradas 1:1 para feed de Instagram', 'Contenido gráfico enfocado en engagement', 'Coherencia de paleta y tipografía']
    }
  },
  {
    id: 'ns-perfumes',
    title: 'NS Perfumes — Instagram Branding',
    category: 'social',
    categoryLabel: 'Branding & Feed',
    oneLiner: 'Diseño de publicaciones estandarizadas para cuadrícula de Instagram y gift cards promocionales.',
    images: getSrcs(canvaGlob, name => name.toLowerCase().includes('ns') || name.toLowerCase().includes('giftcardns')),
    aspectRatio: 'square',
    technologies: ['Canva', 'Figma', 'Visual Identity', 'IG Format'],
    caseStudy: {
      problem: 'Construir una presencia visual sofisticada y pulida en el feed de Instagram.',
      solution: 'Diseño de publicaciones e identidades gráficas en formato post de Instagram (1:1) y piezas impresas/digitales.',
      highlights: ['Línea gráfica elegante para perfumería', 'Formato post de Instagram estandarizado 1:1', 'Grid de diseño cohesivo']
    }
  },
  {
    id: 'ad-lagata',
    title: 'La Gata CR — Ad Campaigns',
    category: 'social',
    categoryLabel: 'Diseño Gráfico & Ads',
    oneLiner: 'Diseños publicitarios en Canva y Figma para campañas e-commerce (1200x400 y 300x250).',
    images: getSrcs(canvaGlob, name => name.toLowerCase().includes('ad_lagata')),
    aspectRatio: 'landscape',
    technologies: ['Figma', 'Canva', 'Branding', 'Meta Ads'],
    caseStudy: {
      problem: 'Mantener consistencia gráfica e impacto visual en pautas publicitarias de Meta Ads.',
      solution: 'Creación de piezas publicitarias adaptadas a formatos de banners promocionales y anuncios laterales.',
      highlights: ['Diseño para formatos de anuncios 1200x400 y 300x250', 'Coherencia cromática y tipográfica de marca']
    }
  },
  {
    id: 'mobile-social',
    title: 'Mobile Social Media & Stories',
    category: 'social',
    categoryLabel: 'Mobile Stories & Reels',
    oneLiner: 'Diseños en formato vertical para historias, publicaciones y campañas promocionales en redes sociales.',
    images: getSrcs(canvaGlob, name => {
      const n = name.toLowerCase();
      return n.includes('ig_postlagata2') || 
             n.includes('ig_postlagata3') || 
             n.includes('ig_postlagata4') || 
             n.includes('ig_postns');
    }),
    aspectRatio: 'portrait',
    technologies: ['Mobile Format 9:16', 'Instagram Stories', 'Reels Design', 'Figma', 'Canva'],
    caseStudy: {
      problem: 'Diseñar contenido vertical envolvente para historias y reels optimizado para pantallas de smartphones.',
      solution: 'Diseño y maquetación de piezas en formato 9:16 con foco en engagement móvil y llamados a la acción.',
      highlights: ['Relación de aspecto 9:16 nativa móvil', 'Composición optimizada para lectura en dispositivos', 'Mockups reales integrados en el carrusel']
    }
  }
];

const filterLabels = {
  all: t('projects.filter.all'),
  web: t('projects.filter.web'),
  figma: t('projects.filter.figma'),
  social: t('projects.filter.social'),
};

const i18nLabels = {
  caseStudy: t('projects.caseStudy'),
  problem: t('projects.problem'),
  solution: t('projects.solution'),
  highlights: t('projects.highlights'),
  stack: t('projects.stack'),
  carousel: t('projects.view.carousel'),
  grid: t('projects.view.grid'),
  prev: t('projects.carousel.prev'),
  next: t('projects.carousel.next'),
  viewFull: t('projects.carousel.viewFull'),
  screens: t('projects.carousel.screens'),
  comingSoon: t('projects.carousel.comingSoon'),
};
---

<section class="section" id="projects">
  <div class="projects-wide-wrapper">
    <div class="projects-header-center">
      <div class="section-label reveal">{t('nav.projects')}</div>
      <h2 class="section-title reveal">
        {t('projects.title')}<br />
        <em style="font-family: var(--font-cursive); font-size: 1.1em; color: var(--rose); opacity: 0.9;">
          {t('projects.subtitle')}
        </em>
      </h2>
    </div>

    <ProjectsCarousel 
      client:visible
      projects={projects}
      filterLabels={filterLabels}
      i18nLabels={i18nLabels}
    />
  </div>

  <ProjectsFloral client:visible />
</section>

<style>
  #projects {
    padding: var(--section-padding, 90px) 0;
    min-height: auto;
    width: 100%;
  }

  .projects-wide-wrapper {
    width: 100%;
    max-width: 1700px;
    margin: 0 auto;
    padding: 0 4vw;
  }

  .projects-header-center {
    text-align: center;
    margin-bottom: 36px;
  }

  @media (max-width: 768px) {
    .projects-wide-wrapper {
      padding: 0 16px;
    }
  }
</style>
